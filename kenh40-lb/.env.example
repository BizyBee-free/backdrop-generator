# Cloudflare Workers KV (preferred durable store)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=

# Server-only wipe key for POST /api/leaderboard/reset (never ship to the browser)
RESET_KEY=

# Brewpage JSON store + HMAC run tokens (server-only; never ship to the browser)
BREWPAGE_OWNER_URL=
BREWPAGE_OWNER_TOKEN=
RUN_SECRET=

# Optional GitHub Contents store (repo-scoped token, server-side only)
GITHUB_TOKEN=
GITHUB_REPO=BizyBee-free/backdrop-generator
GITHUB_PATH=kenh40-lb/data/leaderboard.json
GITHUB_BRANCH=main
